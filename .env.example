# Copy to .env and fill in. Generate the 32-char values with:
#   tr -dc 'A-Za-z0-9' </dev/urandom | head -c32; echo
# Avoid `$`, `=` and `#` in any value (Compose interpolation / .env parsing).
RCON_PASSWORD=
FIREFLY_DB_PASSWORD=
FIREFLY_APP_KEY=
FIREFLY_STATIC_CRON_TOKEN=
FILEBROWSER_ADMIN_PASSWORD=
# Firefly Personal Access Tokens — create after first login (see README).
# Leave blank until then; the dashboard hides Finances while unset.
FIREFLY_API_TOKEN=
FIREFLY_IMPORTER_TOKEN=
