# In Portainer: enter these under this stack's Environment variables.
# Generate 32-char values with: tr -dc 'A-Za-z0-9' </dev/urandom | head -c32; echo
# Avoid `$`, `=` and `#` in any value (Compose interpolation / .env parsing).
# Firefly token for the Finances section; blank hides it.
FIREFLY_API_TOKEN=
# Pi-hole app password (Settings -> Web interface / API -> Configure app password).
PIHOLE_API_PASSWORD=
# Jellyfin -> Dashboard -> API Keys.
JELLYFIN_API_KEY=
# Must match the minecraft stack's RCON_PASSWORD. Blank turns off the Minecraft console.
RCON_PASSWORD=
